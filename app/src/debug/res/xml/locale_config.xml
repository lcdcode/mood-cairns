<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only override of src/main/res/xml/locale_config.xml: the same languages
    plus the en-XA pseudolocale, so it can be picked per-app in system settings
    (Apps > Mood Cairns > Language) without changing the device language.
    Release builds use the main file. Kept in sync by SupportedLocalesTest.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="en-XA" />
</locale-config>
