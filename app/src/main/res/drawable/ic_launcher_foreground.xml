<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground layer. Each lower stone is CLIPPED by the complement of a slightly
  dilated copy (rx+1.5) of every stone drawn on top of it, then the upper stone
  is drawn at true size. This leaves a ~1.5u gap along each overlap that reveals
  the cream background layer, so the mood-stones read as distinct pebbles.
  The clip is rect-minus-ellipse: rect wound CW, dilated ellipse wound CCW via
  the arc sweep flag 0. Stones with two stones on top of them nest two clips.
  The eyes and smile stay as cream shapes painted on top of the head stone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bottom-left (Anxiety), bitten by the bottom-center and middle-left stones -->
    <group>
        <clip-path android:pathData="M0 0 L108 0 L108 108 L0 108 Z
                                     M 41.5 73 A 12.5 12.5 0 1 0 66.5 73 A 12.5 12.5 0 1 0 41.5 73 Z" />
        <group>
            <clip-path android:pathData="M0 0 L108 0 L108 108 L0 108 Z
                                         M 32.5 56 A 12.5 10.5 0 1 0 57.5 56 A 12.5 10.5 0 1 0 32.5 56 Z" />
            <path
                android:pathData="M 26 72 A 11 10 0 1 1 48 72 A 11 10 0 1 1 26 72 Z"
                android:fillColor="#7D99D1" />
        </group>
    </group>

    <!-- Bottom-right (Boredom), bitten by the bottom-center and middle-right stones -->
    <group>
        <clip-path android:pathData="M0 0 L108 0 L108 108 L0 108 Z
                                     M 41.5 73 A 12.5 12.5 0 1 0 66.5 73 A 12.5 12.5 0 1 0 41.5 73 Z" />
        <group>
            <clip-path android:pathData="M0 0 L108 0 L108 108 L0 108 Z
                                         M 50.5 55 A 12.5 10.5 0 1 0 75.5 55 A 12.5 10.5 0 1 0 50.5 55 Z" />
            <path
                android:pathData="M 60 72 A 11 10 0 1 1 82 72 A 11 10 0 1 1 60 72 Z"
                android:fillColor="#9AA39A" />
        </group>
    </group>

    <!-- Bottom-center (Pain), bitten by the middle-left and middle-right stones -->
    <group>
        <clip-path android:pathData="M0 0 L108 0 L108 108 L0 108 Z
                                     M 32.5 56 A 12.5 10.5 0 1 0 57.5 56 A 12.5 10.5 0 1 0 32.5 56 Z" />
        <group>
            <clip-path android:pathData="M0 0 L108 0 L108 108 L0 108 Z
                                         M 50.5 55 A 12.5 10.5 0 1 0 75.5 55 A 12.5 10.5 0 1 0 50.5 55 Z" />
            <path
                android:pathData="M 43 73 A 11 11 0 1 1 65 73 A 11 11 0 1 1 43 73 Z"
                android:fillColor="#B5651D" />
        </group>
    </group>

    <!-- Middle-left (Happiness), bitten by the middle-right and top stones -->
    <group>
        <clip-path android:pathData="M0 0 L108 0 L108 108 L0 108 Z
                                     M 50.5 55 A 12.5 10.5 0 1 0 75.5 55 A 12.5 10.5 0 1 0 50.5 55 Z" />
        <group>
            <clip-path android:pathData="M0 0 L108 0 L108 108 L0 108 Z
                                         M 36.5 38 A 17.5 15.5 0 1 0 71.5 38 A 17.5 15.5 0 1 0 36.5 38 Z" />
            <path
                android:pathData="M 34 56 A 11 9 0 1 1 56 56 A 11 9 0 1 1 34 56 Z"
                android:fillColor="#F6C453" />
        </group>
    </group>

    <!-- Middle-right (Stress), bitten by the top stone -->
    <group>
        <clip-path android:pathData="M0 0 L108 0 L108 108 L0 108 Z
                                     M 36.5 38 A 17.5 15.5 0 1 0 71.5 38 A 17.5 15.5 0 1 0 36.5 38 Z" />
        <path
            android:pathData="M 52 55 A 11 9 0 1 1 74 55 A 11 9 0 1 1 52 55 Z"
            android:fillColor="#D17D7D" />
    </group>

    <!-- Top stone -->
    <path
        android:pathData="M 38 38 A 16 14 0 1 1 70 38 A 16 14 0 1 1 38 38 Z"
        android:fillColor="#6E5A41" />

    <!-- Left eye -->
    <path
        android:pathData="M 48.5 35 A 1.6 1.6 0 1 1 51.7 35 A 1.6 1.6 0 1 1 48.5 35 Z"
        android:fillColor="#FBF7F1" />

    <!-- Right eye -->
    <path
        android:pathData="M 56.3 35 A 1.6 1.6 0 1 1 59.5 35 A 1.6 1.6 0 1 1 56.3 35 Z"
        android:fillColor="#FBF7F1" />

    <!-- Smile -->
    <path
        android:pathData="M 48 40 Q 54 45 60 40"
        android:strokeColor="#FBF7F1"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

</vector>
