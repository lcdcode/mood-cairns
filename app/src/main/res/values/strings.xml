    <string name="backup_export_success">Exported %1$s</string>
    <string name="backup_export_csv_success">Exported %1$s (unencrypted)</string>
    <string name="backup_export_failed">Export failed: %1$s</string>
    <!-- Label: count pairs avoid needing a plural form for each noun. -->
    <string name="backup_import_success">Import complete. Entries: %1$d, scales: %2$d, tags: %3$d, prompt windows: %4$d</string>
    <!-- %1$s is one of the import_error_* sentences. -->
    <string name="backup_import_failed">Import failed: %1$s</string>

    <!-- Reasons a backup import failed. %1$s detail strings are technical, shown as-is. -->
    <string name="import_error_too_large">The file is larger than the %1$d MB limit.</string>
    <string name="import_error_unreadable">Couldn\'t read the file.</string>
    <string name="import_error_unreadable_detail">Couldn\'t read the file (%1$s).</string>
    <string name="import_error_not_a_backup">This file isn\'t a Mood Cairns backup.</string>
    <string name="import_error_wrong_secret">Couldn\'t decrypt the backup. The passphrase is wrong, or the file is damaged.</string>
    <string name="import_error_unsupported_version">This backup uses format version %1$d, which this version of the app can\'t read. Updating the app may help.</string>
    <string name="import_error_malformed">The backup file is damaged (%1$s).</string>
    <string name="import_error_write_failed">Import stopped while saving data (%1$s).</string>
</resources>
