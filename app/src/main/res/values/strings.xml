    <string name="lock_subtitle">Enter PIN to continue</string>
    <string name="lock_pin_label">PIN</string>
    <string name="lock_unlock">Unlock</string>
    <string name="lock_use_biometric">Use biometric</string>
    <!-- %1$s is a remaining duration such as "1m 30s", already localized. -->
    <string name="lock_try_again_in">Try again in %1$s</string>
    <!-- Unlock button while locked out. %1$s is a remaining duration such as "1m 30s". -->
    <string name="lock_locked_for">Locked (%1$s)</string>
    <string name="lock_error_wrong_pin">Incorrect PIN</string>
    <string name="lock_error_too_many_attempts">Too many attempts</string>
    <string name="lock_error_unlock_failed">Couldn\'t unlock: %1$s</string>

    <!-- First-run PIN setup -->
    <string name="set_pin_title">Set a PIN</string>
    <string name="set_pin_intro">Your entries never leave the device. A PIN plus biometric unlock keeps them yours.</string>
    <!-- PIN field label. %1$d minimum, %2$d maximum length; the quantity is the maximum. -->
    <plurals name="set_pin_pin_label">
        <item quantity="one">PIN (%1$d–%2$d digit)</item>
        <item quantity="other">PIN (%1$d–%2$d digits)</item>
