    <string name="scale_edit_error_numbers_required">Enter numeric min, max, and step</string>
    <string name="scale_edit_error_min_not_below_max">Min must be less than max</string>
    <string name="scale_edit_error_step_not_positive">Step must be greater than zero</string>
    <!-- %1$d the range (max - min), %2$s the step. -->
    <string name="scale_edit_error_range_not_step_multiple">Range (%1$d) must be a multiple of step (%2$s)</string>
    <string name="scale_edit_error_default_not_number">Default must be a number</string>
    <!-- %1$d and %2$d are the scale minimum and maximum: a range, not a count. -->
