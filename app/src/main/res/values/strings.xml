<?xml version="1.0" encoding="utf-8"?>
<!--
    English source strings. Translations live in values-<lang>/strings.xml.

    Naming:
      common_*         shared words and labels (buttons, content descriptions)
      error_*          error messages shared by several screens
      enum_*           display names of stored enum values
      <screen>_*       text owned by one screen, e.g. settings_*, backup_*
      <screen>_error_* errors owned by one screen
      import_error_*   reasons a backup import failed

    Rules:
      - Always use positional args (%1$s, %2$d) so translators can reorder them.
      - Never build sentences by concatenating strings in code; give translators
        the whole sentence.
      - Anything with a count is a <plurals>, even when English looks the same.
      - Text marked translatable="false" must not be translated.
-->
