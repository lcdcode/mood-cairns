    <!-- Backup screen -->
    <string name="backup_title">Backup &amp; import</string>
    <string name="backup_intro">Backups are AES-GCM encrypted with a key derived from a passphrase you choose and written to Documents/MoodCairns. Syncthing or any file manager can sync them off-device - the app never uploads anything.</string>
