<?xml version="1.0" encoding="utf-8"?>
<!--
    English source strings. Translations live in values-<lang>/strings.xml.

    Naming:
      common_*         shared words and labels (buttons, content descriptions)
      error_*          error messages shared by several screens
      enum_*           display names of stored enum values
      <screen>_*       text owned by one screen, e.g. settings_*, backup_*
      <screen>_error_* errors owned by one screen
      import_error_*   reasons a backup import failed

    Rules:
      - Always use positional args (%1$s, %2$d) so translators can reorder them.
      - Never build sentences by concatenating strings in code; give translators
        the whole sentence.
      - Anything with a count is a <plurals>, even when English looks the same.
      - Text marked translatable="false" must not be translated.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name" translatable="false">Mood Cairns</string>
    <string name="widget_title">Log mood</string>
    <string name="widget_subtitle">Tap to open Mood Cairns</string>
    <string name="widget_description">Quick-log your mood</string>

    <!-- Common -->
    <string name="common_back">Back</string>
    <string name="common_cancel">Cancel</string>
    <string name="common_edit">Edit</string>
    <string name="common_enable">Enable</string>
    <string name="common_loading">Loading…</string>
    <string name="common_next">Next</string>
    <string name="common_ok">OK</string>
    <string name="common_save">Save</string>
    <string name="common_saving">Saving…</string>
    <!-- Abbreviated durations, e.g. on auto-lock timeout chips. -->
    <plurals name="common_duration_seconds_short">
        <item quantity="one">%1$d s</item>
        <item quantity="other">%1$d s</item>
    </plurals>
    <plurals name="common_duration_minutes_short">
        <item quantity="one">%1$d min</item>
        <item quantity="other">%1$d min</item>
    </plurals>

    <!-- Shared errors. %1$s in *_failed strings is a technical detail, shown as-is. -->
    <string name="error_save_failed">Couldn\'t save: %1$s</string>
    <string name="error_delete_failed">Couldn\'t delete: %1$s</string>
    <string name="error_name_required">Name required</string>
    <string name="error_pins_mismatch">PINs don\'t match</string>
    <plurals name="error_pin_too_short">
        <item quantity="one">PIN must be at least %1$d digit</item>
        <item quantity="other">PIN must be at least %1$d digits</item>
    </plurals>

    <!-- Prompt slot names. Morning/Evening are the built-in check-in times; Manual is an
         entry logged outside any prompt; Custom is a user-defined prompt window. -->
    <string name="enum_prompt_slot_morning">Morning</string>
    <string name="enum_prompt_slot_evening">Evening</string>
    <string name="enum_prompt_slot_manual">Manual</string>
    <string name="enum_prompt_slot_custom">Custom</string>

    <!-- Tag category names, shown as section headings over groups of tags. -->
    <string name="enum_tag_category_place">Places</string>
    <string name="enum_tag_category_person">People</string>
    <string name="enum_tag_category_activity">Activities</string>
    <string name="enum_tag_category_mood">Moods</string>
    <string name="enum_tag_category_other">Other</string>

    <!-- Notifications -->
    <string name="notif_channel_prompts_name">Mood prompts</string>
    <string name="notif_channel_prompts_description">Gentle reminders to log how you\'re feeling.</string>
    <string name="notif_prompt_default_title">Time to check in</string>
    <string name="notif_prompt_text">Log how you\'re feeling</string>
    <string name="notif_test_title">Test notification</string>

    <!-- Home screen -->
    <string name="home_tagline">Log how you\'re feeling, privately.</string>
    <string name="home_log_entry">Log entry</string>
    <string name="home_history">View history</string>
    <string name="home_charts">Charts</string>
    <string name="home_backup">Backup &amp; import</string>
    <string name="home_scales">Manage scales</string>
    <string name="home_tags">Manage tags</string>
