    <!-- Change PIN screen -->
    <string name="change_pin_title_change">Change PIN</string>
    <string name="change_pin_title_set">Set PIN</string>
    <string name="change_pin_action_change">Change PIN</string>
    <string name="change_pin_action_set">Set PIN</string>
    <string name="change_pin_action_remove">Remove PIN</string>
    <string name="change_pin_current_label">Current PIN</string>
    <string name="change_pin_new_label">New PIN</string>
