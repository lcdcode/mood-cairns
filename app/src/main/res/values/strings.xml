    <string name="home_about">About</string>

    <!-- Entry screen -->
    <string name="entry_title_new">How are you?</string>
    <string name="entry_title_edit">Edit entry</string>
    <string name="entry_no_scales">No scales configured. Add one from Manage scales.</string>
    <string name="entry_note_label">Note (optional)</string>
    <string name="entry_prompt_slot_label">Prompt slot</string>
    <string name="entry_change_date_time">Change date/time…</string>
    <!-- Screen-reader description of a scale slider. %1$s scale name, %2$s current value,
         %3$d maximum. -->
    <string name="entry_slider_description_out_of">%1$s, value %2$s out of %3$d</string>
    <!-- For scales with negative values. %1$s scale name, %2$s current value, %3$d minimum,
         %4$d maximum: a range, not a count. -->
    <string name="entry_slider_description_range" tools:ignore="PluralsCandidate">%1$s, value %2$s in range %3$d to %4$d</string>
    <!-- For scales where a lower value is the better outcome. %1$s is one of the
         descriptions above. -->
    <string name="entry_slider_description_lower_better">%1$s, lower is better</string>

    <!-- Data store upgrade (shown once, when migrating to the encrypted database) -->
    <string name="migrating_title">Upgrading data store…</string>
    <string name="migrating_body">Your existing entries are being moved to the encrypted database. Don\'t close the app.</string>
    <string name="migration_failed_title">Upgrade failed</string>
    <string name="migration_failed_body">Your original data is still on disk. Reopen the app to retry, or uninstall and restore from a backup if the issue persists.</string>

    <!-- Biometric unlock prompt -->
    <string name="biometric_prompt_title">Unlock Mood Cairns</string>
    <string name="biometric_prompt_subtitle">Authenticate to continue</string>
    <string name="biometric_prompt_use_pin">Use PIN</string>

    <!-- Warning before running without a PIN, at first-run setup or when removing a PIN -->
    <string name="no_pin_warning_title_setup">Continue without a PIN?</string>
    <string name="no_pin_warning_title_remove">Remove your PIN?</string>
    <string name="no_pin_warning_body">Without a PIN, anyone who can use this unlocked device can open Mood Cairns and read all of your entries. Your data is still encrypted on disk, but only by your device\'s secure keystore - the extra protection a PIN provides will be removed, and biometric unlock will be turned off. You can set a PIN again any time in Settings.</string>
    <string name="no_pin_warning_accept">Accept and continue</string>

    <!-- Settings screen -->
    <string name="settings_title">Settings</string>
    <string name="settings_section_prompt_windows">Prompt windows</string>
    <string name="settings_add_window">Add window</string>
    <!-- Prompt window row. %1$s start time, %2$s end time, %3$s slot name. -->
    <string name="settings_window_summary">%1$s – %2$s · %3$s</string>
    <string name="settings_section_security">Security</string>
    <string name="settings_auto_lock_label">Auto-lock after background</string>
    <string name="settings_auto_lock_immediate">Immediate</string>
    <string name="settings_biometric_unlock">Biometric unlock</string>
    <string name="settings_change_pin">Change PIN</string>
    <string name="settings_lock_now">Lock now</string>
    <string name="settings_set_pin">Set PIN</string>
    <string name="settings_no_pin_explanation">No PIN set. Your data is encrypted on this device but protected only by your device\'s keystore, not by a PIN. Auto-lock, biometric unlock, and lock-now are unavailable without a PIN.</string>
    <string name="settings_section_backup">Backup &amp; export</string>
    <string name="settings_allow_unsafe_exports">Allow unsafe exports</string>
    <string name="settings_allow_unsafe_exports_summary">Enables an unencrypted CSV export under Backup &amp; import. Off by default.</string>
    <string name="settings_unsafe_exports_dialog_title">Allow unsafe exports?</string>
    <string name="settings_unsafe_exports_dialog_body">This adds an option to export your data as an unencrypted CSV file to shared storage. That file is plain text with no passphrase: cloud backup services, file managers, and any other app that can read shared storage will be able to read all of your entries.\n\nOnly enable this if you understand and accept that danger.</string>
    <string name="settings_section_diagnostics">Diagnostics</string>
    <plurals name="settings_test_notification">
        <item quantity="one">Test notification (fires in %1$d second)</item>
        <item quantity="other">Test notification (fires in %1$d seconds)</item>
    </plurals>

    <!-- Lock screen -->
